# Local development only. Never commit real secrets.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
WEB_BASE_URL=http://localhost:5174
DATABASE_URL=postgres://antro:antro_dev_only@localhost:5433/antro_hrms
DEFAULT_TIMEZONE=Asia/Kolkata
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
ENABLE_PF=false
ENABLE_TDS=false

# Password given to all synthetic demo users by `manage.py seed_demo` (dev only)
SEED_DEMO_PASSWORD=choose-a-dev-password
